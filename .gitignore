# ============================================
# UNOBIX - Git Ignore
# Arquivos que NÃO devem ser commitados no Git
# ============================================

# Arquivos de ambiente (SENSÍVEIS!)
.env
.env.local
.env.*.local

# Arquivos de configuração sensíveis
config.local.php
firebase-config.local.js

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
tmp/
temp/
*.tmp
*.temp

# Dependências
node_modules/
vendor/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Sistema operacional
.DS_Store
Thumbs.db

# Backups
*.bak
*.backup

# Arquivos gerados
dist/
build/
*.min.js
*.min.css

# Uploads
uploads/
storage/

# Cache
.cache/

# Testes
coverage/

# Documentação temporária
ANALYSIS_*.md
BLOCO_*.md
check-security-fixes.sh