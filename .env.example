# ============================================
# UNOBIX - Variáveis de Ambiente (.env)
# NUNCA COMMITAR ESTE ARQUIVO NO GIT!
# Copiar para .env e preencher com valores reais
# ============================================

# ============================================
# BANCO DE DADOS MYSQL
# ============================================

# Opção 1: URL completa do Railway
MYSQL_PUBLIC_URL=mysql://usuario:senha@host:porta/banco

# Opção 2: Variáveis individuais (se não usar URL)
MYSQLHOST=interchange.proxy.rlwy.net
MYSQLPORT=40129
MYSQLDATABASE=railway
MYSQLUSER=root
MYSQLPASSWORD=SUA_SENHA_SEGURA_AQUI

# ============================================
# CHAVES DE SEGURANÇA
# ============================================

# Chave secreta para criptografia do jogo
GAME_SECRET_KEY=SUA_CHAVE_SECRETA_AQUI

# Senha de administração (para endpoints admin)
ADMIN_PASSWORD=SENHA_ADMIN_SEGURA_AQUI

# ============================================
# FIREBASE / GOOGLE AUTH
# ============================================

# Configurações do Firebase (NUNCA no JavaScript do cliente!)
FIREBASE_PROJECT_ID=seu-projeto-firebase
FIREBASE_API_KEY=SUA_API_KEY_DO_FIREBASE

# ============================================
# hCAPTCHA
# ============================================

# Chave secreta do hCaptcha
HCAPTCHA_SECRET_KEY=SUA_CHAVE_SECRETA_HCAPTCHA

# ============================================
# CONFIGURAÇÕES DO JOGO
# ============================================

# APY do staking (em porcentagem)
STAKING_APY=5

# Tempo mínimo de staking (em dias)
STAKING_MIN_DAYS=7

# ============================================
# CONFIGURAÇÕES DE SAQUE
# ============================================

# Valor mínimo para saque (em BRL)
WITHDRAW_MIN_AMOUNT=1.00

# Dias de processamento (ex: 20-25 do mês)
WITHDRAW_PROCESSING_DAYS_START=20
WITHDRAW_PROCESSING_DAYS_END=25

# ============================================
# CONFIGURAÇÕES DE EMAIL (opcional)
# ============================================

# SMTP para envio de emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=SUA_SENHA_EMAIL

# ============================================
# LOGGING E MONITORAMENTO
# ============================================

# Nível de logging (debug, info, warning, error)
LOG_LEVEL=warning

# URL para webhooks de monitoramento
WEBHOOK_URL=https://seu-webhook.com/alertas

# ============================================
# AMBIENTE (development, staging, production)
# ============================================
APP_ENV=production
DEBUG=false