# ============================================
# UNOBIX - Variáveis de Ambiente (.env)
# NUNCA COMMITAR ESTE ARQUIVO NO GIT!
# Copiar para .env e preencher com valores reais
# ============================================

# ============================================
# BANCO DE DADOS CLOUD SQL (Google Cloud)
# ============================================

# Configuração para Cloud SQL via Cloud SQL Proxy
MYSQLHOST=127.0.0.1           # Cloud SQL Proxy redireciona para Cloud SQL
MYSQLPORT=3306                # Porta padrão MySQL
MYSQLDATABASE=unobix_db       # Nome do database no Cloud SQL
MYSQLUSER=unobix_user         # Usuário do banco
MYSQLPASSWORD=SUA_SENHA_SEGURA_AQUI  # Senha do usuário

# ============================================
# CHAVES DE SEGURANÇA
# ============================================
GAME_SECRET_KEY=GERAR_CHAVE_SECRETA_ÚNICA_AQUI  # Para tokens de sessão
ADMIN_PASSWORD=SENHA_ADMIN_FORTE_AQUI           # Senha do painel administrativo
ADMIN_USER=admin                                # Usuário admin (opcional mudar)

# ============================================
# FIREBASE / GOOGLE AUTH
# ============================================
FIREBASE_PROJECT_ID=unobix-oauth-a69cd          # ID do projeto Firebase
FIREBASE_API_KEY=SUA_API_KEY_FIREBASE_AQUI      # API Key do Firebase (web)

# ============================================
# hCAPTCHA (opcional - para proteção contra bots)
# ============================================
HCAPTCHA_SITE_KEY=SUA_CHAVE_SITE_HCAPTCHA       # Chave pública (opcional)
HCAPTCHA_SECRET_KEY=SUA_CHAVE_SECRETA_HCAPTCHA  # Chave privada (opcional)

# ============================================
# CONFIGURAÇÕES DO JOGO
# ============================================
STAKING_APY=5                                   # APY do staking (5%)
STAKING_MIN_DAYS=7                              # Dias mínimos para staking
WITHDRAW_MIN_AMOUNT=1.00                        # Valor mínimo para saque (BRL)
WITHDRAW_PROCESSING_DAYS_START=20               # Dia inicial para processar saques
WITHDRAW_PROCESSING_DAYS_END=25                 # Dia final para processar saques

# ============================================
# AMBIENTE
# ============================================
APP_ENV=production                              # production, development, testing
DEBUG=false                                     # true para debug, false para produção